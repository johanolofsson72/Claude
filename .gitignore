.DS_Store
*.db
temp/
.env
appsettings.Development.json
.claude/validation/
.claude/.local-llm-*
.claude/local-llm-*.log
.claude/local-llm-*.log.errors
.claude/graphify-*.log
.claude/graphify-*.log.errors
.claude/projects/
.claude/settings.local.json
CLAUDE.local.md

# Template auto-sync rate-limit marker (machine-local; the manifest .claude/.template-sync IS tracked)
.claude/.template-sync-check

# Attempt counters for the repeat-failure guard (machine-local, TTL-pruned)
.claude/state/

# Python bytecode cache — the guards import scripts/spec_active.py (spec 007m),
# so python3 writes a __pycache__ next to the hooks on every run.
__pycache__/
*.pyc

# Agent worktrees. `isolation: worktree` agents check out under here, and git
# records each one as a gitlink (mode 160000) if it is not ignored — which then
# shows as permanently modified as that worktree's HEAD moves, so the tree is
# never clean and the noise hides real changes. scripts/prune-agent-worktrees.sh
# removes abandoned ones; this keeps them out of the index in the first place.
.claude/worktrees/
