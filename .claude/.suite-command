# Template self-test suite: every scripts/test-*.sh, each judged by its exit code (F047).
# Exit 124 from timeout is UNMEASURED, not FAIL (spec 093, F111): the suite exits 124 when timeouts are its only non-green results.
f=0; to=0; for t in scripts/test-*.sh; do timeout 900 bash "$t" >/dev/null 2>&1; rc=$?; if [ "$rc" -eq 0 ]; then echo "ok   $t"; elif [ "$rc" -eq 124 ]; then echo "TIMEOUT $t — unmeasured after 900s"; to=1; else echo "FAIL $t"; f=1; fi; done; echo "suite: $(ls scripts/test-*.sh | wc -l | tr -d ' ') scripts"; [ "$f" -eq 1 ] && exit 1; [ "$to" -eq 1 ] && exit 124; exit 0
