# Playwright MCP scratch — screenshots and snapshots from a browser session,
# written into whatever directory the tool ran from. A plugin's scratch, not the
# harness's, so it stays out of the managed block below.
.playwright-mcp/

# Every path the harness itself writes machine-local is in the block below, and
# the reason for each is in scripts/harness-gitignore.sh (spec 040). The sync
# writes the same block into every project's .gitignore; this repository carries
# it too, and test-harness-gitignore.sh fails when it goes stale.

# >>> claude-code harness (managed by scripts/harness-gitignore.sh) >>>
# Written by the template sync and replaced on every sync. Add your own ignores
# outside these markers. Why each path is here: scripts/harness-gitignore.sh.
.claude/state/
.claude/validation/
.claude/.maintenance-state
.claude/.template-sync-check
.claude/.bash-write-marker
.claude/.bash-write-blocked
.claude/.local-llm-*
.claude/local-llm-*.log
.claude/local-llm-*.log.errors
.claude/graphify-*.log
.claude/graphify-*.log.errors
.claude/settings.local.json
.claude/projects/
.claude/worktrees/
.specify/feature.json
__pycache__/
scripts/.trusted-*
CLAUDE.local.md
